{
  "name": "@deckuse/cli",
  "version": "0.0.0",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": {
      "types": "./dist/bin.d.ts",
      "import": "./dist/bin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@deckuse/core": "workspace:*",
    "@deckuse/pptx": "workspace:*",
    "@deckuse/docx": "workspace:*",
    "@deckuse/xlsx": "workspace:*",
    "@deckuse/key": "workspace:*",
    "@deckuse/numbers": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "deckuse": "./dist/bin.js"
  },
  "devDependencies": {
    "@deckuse/opc": "workspace:*"
  }
}
