{
  "name": "@deckflow/deckuse",
  "version": "1.0.2",
  "license": "AGPL-3.0",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": {
      "types": "./dist/bin.d.ts",
      "import": "./dist/bin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/generate-cli-version.mjs && tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@deckflow/deckuse-core": "workspace:*",
    "@deckflow/deckuse-pptx": "workspace:*",
    "@deckflow/deckuse-docx": "workspace:*",
    "@deckflow/deckuse-xlsx": "workspace:*",
    "@deckflow/deckuse-key": "workspace:*",
    "@deckflow/deckuse-numbers": "workspace:*",
    "@deckflow/deckuse-workspace": "workspace:*",
    "@deckflow/office2html": "^0.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "deckuse": "./dist/bin.js"
  },
  "devDependencies": {
    "@deckflow/deckuse-opc": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deckflow/deckuse.git",
    "directory": "packages/deckuse"
  },
  "homepage": "https://github.com/deckflow/deckuse#readme"
}
